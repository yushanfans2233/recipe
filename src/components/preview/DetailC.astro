---
import type { RecipeParts } from '../../lib/recipe-html';

interface Props {
  title: string;
  category: string;
  tags: string[];
  parts: RecipeParts;
}

const { title, category, parts } = Astro.props;
---

<article class="recipe-body page">
  <header class="head">
    <h1 class="title">{title}</h1>
    <p class="meta">{category} · {parts.steps.length} 步</p>
  </header>

  <div class="layout">
    <aside class="rail">
      {parts.side.map((block) => <Fragment set:html={block} />)}
    </aside>

    <div class="steps">
      {parts.steps.map((block) => <Fragment set:html={block} />)}
    </div>
  </div>

  {parts.tips && <section class="tips" set:html={parts.tips} />}
</article>

<style>
  .page {
    max-width: 1180px;
    margin: 0 auto;
    padding: 1.6rem 1.5rem 3rem;
  }

  .head {
    display: flex;
    gap: 1.2rem;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 0.7rem;
    border-bottom: 2px solid var(--dp-color-ink);
  }

  .title {
    font-family: var(--dp-typography-display-face);
    font-size: 1.95rem;
    line-height: 1.15;
  }

  .meta {
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    color: var(--dp-color-annotation);
    white-space: nowrap;
  }

  .layout {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 2.6rem;
    align-items: start;
    margin-top: 1.4rem;
  }

  .rail {
    padding-right: 2.2rem;
    border-right: 1px solid color-mix(in srgb, var(--dp-color-line) 50%, transparent);
  }

  .rail :global(h2) {
    margin: 0 0 0.35rem;
    border: 0;
    background: none;
    font-family: var(--dp-typography-reading-face);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    color: var(--dp-color-annotation);
  }

  .rail :global(h3) {
    margin: 0.8rem 0 0.1rem;
    font-family: var(--dp-typography-reading-face);
    font-size: 0.84rem;
    font-weight: 400;
    color: var(--dp-color-ink);
  }

  .rail :global(p) {
    margin: 0.7rem 0 0.1rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--dp-color-annotation);
  }

  .rail :global(table) {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .rail :global(thead) {
    display: none;
  }

  .rail :global(td) {
    padding: 0.22rem 0;
    border-bottom: 1px dotted color-mix(in srgb, var(--dp-color-line) 60%, transparent);
    background: none;
  }

  .rail :global(td:last-child) {
    padding-left: 0.8rem;
    color: var(--dp-color-ink-muted);
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .steps {
    counter-reset: stepblock;
    min-width: 0;
  }

  .steps :global(.step-block) {
    counter-increment: stepblock;
    padding-top: 0.9rem;
    border-top: 1px solid color-mix(in srgb, var(--dp-color-line) 40%, transparent);
  }

  .steps :global(.step-block:first-of-type) {
    padding-top: 0;
    border-top: 0;
  }

  .steps :global(.step-block h3) {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    margin: 0 0 0.35rem;
    padding: 0;
    background: none;
    font-size: 1.16rem;
    line-height: 1.3;
  }

  .steps :global(.step-name) {
    font-family: var(--dp-typography-display-face);
  }

  .steps :global(.step-block h3::before) {
    content: counter(stepblock);
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border: 1.5px solid color-mix(in srgb, var(--dp-color-accent) 45%, transparent);
    border-radius: 58% 42% 55% 45% / 45% 55% 48% 52%;
    font-family: var(--dp-typography-display-face);
    font-size: 0.68rem;
    color: var(--dp-color-accent);
    transform: translateY(0.15rem);
  }

  .steps :global(.step-time) {
    margin-left: auto;
    font-family: var(--dp-typography-reading-face);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--dp-color-annotation);
  }

  .steps :global(.step-block > ol) {
    margin: 0;
    padding-left: 0.2rem;
    counter-reset: none;
  }

  .steps :global(.step-block > ol > li) {
    margin-top: 0.28rem;
    padding-left: 1rem;
    font-size: 0.92rem;
    line-height: 1.75;
  }

  .steps :global(.step-block > ol > li)::before {
    content: "·";
    top: 0.1em;
    width: auto;
    height: auto;
    border: 0;
    background: none;
    color: var(--dp-color-line);
  }

  .steps :global(.step-block strong) {
    background: none;
    font-weight: 700;
    font-synthesis: weight;
  }

  .tips {
    margin-top: 1.6rem;
    padding-top: 0.8rem;
    border-top: 1px solid color-mix(in srgb, var(--dp-color-line) 40%, transparent);
    columns: 1;
  }

  .tips :global(h2) {
    margin: 0 0 0.5rem;
    border: 0;
    background: none;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    color: var(--dp-color-annotation);
  }

  .tips :global(ol) {
    margin: 0;
  }

  .tips :global(ol > li) {
    font-size: 0.86rem;
    line-height: 1.75;
  }

  @media (max-width: 899px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }

    .rail {
      padding-right: 0;
      border-right: 0;
      border-bottom: 1px solid color-mix(in srgb, var(--dp-color-line) 50%, transparent);
      padding-bottom: 1rem;
    }

    .tips {
      columns: 1;
    }
  }
</style>
