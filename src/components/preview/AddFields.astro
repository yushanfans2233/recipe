---
/** 添加菜谱表单的字段部分，三个版式共用 */
---

<section class="form-section" data-step="1">
  <h2 class="form-section-title"><span class="form-step-no">1</span>基本信息</h2>

  <div class="form-grid three">
    <label class="form-field">
      <span class="form-label">菜名</span>
      <input class="form-input" type="text" placeholder="比如：醋炝豆芽" />
    </label>
    <label class="form-field">
      <span class="form-label">分类</span>
      <select class="form-select">
        <option>蔬菜</option>
        <option>蛋白质</option>
        <option>主食</option>
      </select>
    </label>
    <label class="form-field">
      <span class="form-label">标签（逗号分隔）</span>
      <input class="form-input" type="text" placeholder="早饭, 素菜" />
    </label>
  </div>

  <div class="form-grid two" style="margin-top: 1.2rem">
    <div class="form-field">
      <span class="form-label">封面照片</span>
      <div class="form-photo">
        <strong>拖入照片 / 点击选择</strong>
        <span>自动压成 WebP，最长边 1600px</span>
      </div>
    </div>
    <label class="form-field">
      <span class="form-label">一句话说明（可选）</span>
      <textarea class="form-textarea" placeholder="写点这道菜的来历或要点"></textarea>
    </label>
  </div>
</section>

<section class="form-section" data-step="2">
  <h2 class="form-section-title"><span class="form-step-no">2</span>食材</h2>

  <p class="form-group-label">主食材</p>
  <div class="form-rows">
    <div class="form-row">
      <label class="form-field"><span class="form-label">名称</span><input class="form-input" type="text" placeholder="绿豆芽" /></label>
      <label class="form-field"><span class="form-label">用量</span><input class="form-input" type="text" placeholder="500g" /></label>
      <button type="button" class="form-remove" aria-label="删除这一行">×</button>
    </div>
    <div class="form-row">
      <label class="form-field"><span class="form-label">名称</span><input class="form-input" type="text" placeholder="大蒜" /></label>
      <label class="form-field"><span class="form-label">用量</span><input class="form-input" type="text" placeholder="5~6 瓣" /></label>
      <button type="button" class="form-remove" aria-label="删除这一行">×</button>
    </div>
  </div>
  <button type="button" class="form-add">+ 添加食材</button>

  <p class="form-group-label">调味</p>
  <div class="form-rows">
    <div class="form-row">
      <label class="form-field"><span class="form-label">名称</span><input class="form-input" type="text" placeholder="干辣椒" /></label>
      <label class="form-field"><span class="form-label">用量</span><input class="form-input" type="text" placeholder="适量" /></label>
      <button type="button" class="form-remove" aria-label="删除这一行">×</button>
    </div>
  </div>
  <button type="button" class="form-add">+ 添加调味</button>
</section>

<section class="form-section" data-step="3">
  <h2 class="form-section-title"><span class="form-step-no">3</span>制作流程</h2>

  <div class="step-editor">
    <div class="form-grid three">
      <label class="form-field">
        <span class="form-label">步骤名</span>
        <input class="form-input" type="text" placeholder="处理豆芽" />
      </label>
      <label class="form-field">
        <span class="form-label">用时</span>
        <input class="form-input" type="text" placeholder="10min" />
      </label>
      <button type="button" class="form-remove" aria-label="删除这一步">×</button>
    </div>
    <label class="form-field" style="margin-top: 0.9rem">
      <span class="form-label">这一步做什么（一行一条）</span>
      <textarea class="form-textarea" placeholder="盆里加水、盐、白醋，浸泡 10min 后轻轻淘洗&#10;控干水分备用"></textarea>
    </label>
  </div>

  <div class="step-editor">
    <div class="form-grid three">
      <label class="form-field">
        <span class="form-label">步骤名</span>
        <input class="form-input" type="text" placeholder="炝炒" />
      </label>
      <label class="form-field">
        <span class="form-label">用时</span>
        <input class="form-input" type="text" placeholder="5min" />
      </label>
      <button type="button" class="form-remove" aria-label="删除这一步">×</button>
    </div>
    <label class="form-field" style="margin-top: 0.9rem">
      <span class="form-label">这一步做什么（一行一条）</span>
      <textarea class="form-textarea" placeholder="猪油润锅，油热后下小料&#10;全程大火爆炒，出锅前加白醋"></textarea>
    </label>
  </div>

  <button type="button" class="form-add">+ 添加步骤</button>
</section>

<section class="form-section" data-step="4">
  <h2 class="form-section-title"><span class="form-step-no">4</span>TIPS</h2>

  <label class="form-field">
    <span class="form-label">注意事项（一行一条，可以留空）</span>
    <textarea
      class="form-textarea"
      style="min-height: 6rem"
      placeholder="豆芽泡好后一定要控干，不然下锅会出水"></textarea>
  </label>
</section>

<style>
  .step-editor {
    margin-bottom: 1rem;
    padding: 1rem 1rem 1.1rem;
    border: var(--dp-border-fine-stroke) dashed color-mix(in srgb, var(--dp-color-line) 70%, transparent);
    border-radius: var(--dp-radius-control);
  }

  .form-rows {
    margin-top: 0.2rem;
  }
</style>
