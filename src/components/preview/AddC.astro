---
import AddFields from './AddFields.astro';
---

<div class="form-shell">
  <header class="add-head">
    <p class="form-kicker">新建菜谱</p>
    <h1 class="form-title">添加菜谱</h1>
    <p class="form-hint">一次填一步，填完就能直接生成。</p>
  </header>

  <ol class="wizard-steps" aria-label="填写进度">
    <li class="is-current"><span>1</span>基本信息</li>
    <li><span>2</span>食材</li>
    <li><span>3</span>制作流程</li>
    <li><span>4</span>TIPS</li>
  </ol>

  <div class="wizard-body">
    <AddFields />
  </div>

  <div class="wizard-nav">
    <button type="button" class="sketch-btn" data-wizard-prev>上一步</button>
    <span class="wizard-count" data-wizard-count>1 / 4</span>
    <button type="button" class="sketch-btn btn-primary" data-wizard-next>下一步</button>
  </div>
</div>

<style>
  .add-head {
    margin-bottom: 0.4rem;
  }

  .wizard-steps {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.6rem 0 0;
    padding: 0;
    list-style: none;
  }

  .wizard-steps li {
    display: flex;
    gap: 0.45rem;
    align-items: center;
    padding: 0.15rem 0.75rem 0.2rem;
    border: var(--dp-border-fine-stroke) dashed color-mix(in srgb, var(--dp-color-line) 95%, transparent);
    border-radius: var(--dp-radius-control);
    color: var(--dp-color-ink-muted);
    font-size: 0.88rem;
  }

  .wizard-steps li span {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border: 1px solid currentColor;
    border-radius: 50%;
    font-size: 0.68rem;
  }

  .wizard-steps li.is-current {
    border-style: solid;
    border-color: var(--dp-color-ink);
    background-color: var(--dp-color-scrap);
    color: var(--dp-color-ink);
  }

  .wizard-steps li.is-done {
    color: var(--dp-color-annotation);
  }

  .wizard-nav {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 1.6rem;
  }

  .wizard-count {
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--dp-color-ink-muted);
  }

  .wizard-body > :global(.form-section) {
    display: none;
  }

  .wizard-body > :global(.form-section.is-active) {
    display: block;
  }
</style>

<script>
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.wizard-body .form-section'));
  const steps = Array.from(document.querySelectorAll<HTMLElement>('.wizard-steps li'));
  const counter = document.querySelector<HTMLElement>('[data-wizard-count]');
  const prev = document.querySelector<HTMLButtonElement>('[data-wizard-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-wizard-next]');
  let current = 1;

  function render() {
    sections.forEach((section, index) => {
      section.classList.toggle('is-active', index === current - 1);
    });
    steps.forEach((step, index) => {
      step.classList.toggle('is-current', index === current - 1);
      step.classList.toggle('is-done', index < current - 1);
    });
    if (counter) counter.textContent = `${current} / ${sections.length}`;
    if (prev) prev.disabled = current === 1;
    if (next) {
      next.disabled = current === sections.length;
      next.textContent = current === sections.length ? '完成' : '下一步';
    }
  }

  prev?.addEventListener('click', () => {
    if (current > 1) {
      current -= 1;
      render();
    }
  });

  next?.addEventListener('click', () => {
    if (current < sections.length) {
      current += 1;
      render();
    }
  });

  render();
</script>
