---
import AddFields from './AddFields.astro';
---

<div class="form-shell">
  <header class="add-head">
    <p class="form-kicker">新建菜谱</p>
    <h1 class="form-title">添加菜谱</h1>
    <p class="form-hint">左边填，右边实时预览成菜谱页的样子。</p>
  </header>

  <div class="split">
    <div class="form-main">
      <AddFields />

      <div class="form-actions">
        <button type="button" class="sketch-btn btn-primary">生成 Markdown</button>
        <button type="button" class="sketch-btn">存为草稿</button>
        <button type="button" class="sketch-btn">清空</button>
      </div>
    </div>

    <aside class="form-aside">
      <p class="aside-label">预览</p>

      <div class="preview-card">
        <div class="preview-photo"><span>封面照片</span></div>
        <div class="preview-body">
          <p class="preview-title">醋炝豆芽</p>
          <p class="preview-meta">蔬菜 · 2 步 · 约 25min</p>

          <div class="preview-facts">
            <p><span>绿豆芽</span><span>500g</span></p>
            <p><span>大蒜</span><span>5~6 瓣</span></p>
            <p><span>干辣椒</span><span>适量</span></p>
          </div>

          <div class="preview-step">
            <span class="preview-no">1</span>
            <span class="preview-name">处理豆芽</span>
            <span class="preview-time">15min</span>
          </div>
          <div class="preview-step">
            <span class="preview-no">2</span>
            <span class="preview-name">炝炒</span>
            <span class="preview-time">10min</span>
          </div>
        </div>
      </div>
    </aside>
  </div>
</div>

<style>
  .add-head {
    margin-bottom: 0.4rem;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 2.4rem;
    align-items: start;
  }

  .form-aside {
    position: sticky;
    top: 1.2rem;
  }

  .aside-label {
    margin-bottom: 0.7rem;
    font-family: var(--dp-typography-display-face);
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    color: var(--dp-color-annotation);
  }

  .preview-card {
    padding: 12px;
    background-color: var(--dp-color-scrap);
    border: var(--dp-border-fine-stroke) solid color-mix(in srgb, var(--dp-color-line) 80%, transparent);
    box-shadow: 3px 3px 0 rgba(56, 53, 47, 0.1);
    transform: rotate(-0.4deg);
  }

  .preview-photo {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    background-color: #efe9dc;
    color: var(--dp-color-line);
    font-size: 0.85rem;
  }

  .preview-body {
    padding: 0.9rem 0.3rem 0.3rem;
  }

  .preview-title {
    font-family: var(--dp-typography-display-face);
    font-size: 1.35rem;
    color: var(--dp-color-ink);
  }

  .preview-meta {
    margin-top: 0.2rem;
    font-size: 0.78rem;
    color: var(--dp-color-annotation);
  }

  .preview-facts {
    margin-top: 0.9rem;
    font-size: 0.82rem;
  }

  .preview-facts p {
    display: flex;
    justify-content: space-between;
    gap: 0.6rem;
    padding: 0.28rem 0;
    border-bottom: 1px dashed color-mix(in srgb, var(--dp-color-line) 60%, transparent);
  }

  .preview-facts p span:last-child {
    color: var(--dp-color-ink-muted);
  }

  .preview-step {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-top: 0.7rem;
    padding: 0.5rem 0.6rem;
    background-color: var(--dp-color-ground);
    border: 1px solid color-mix(in srgb, var(--dp-color-line) 65%, transparent);
  }

  .preview-no {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    border: 1px solid color-mix(in srgb, var(--dp-color-accent) 55%, transparent);
    border-radius: 58% 42% 55% 45% / 45% 55% 48% 52%;
    font-size: 0.68rem;
    color: var(--dp-color-accent);
  }

  .preview-name {
    font-family: var(--dp-typography-display-face);
    font-size: 0.95rem;
  }

  .preview-time {
    margin-left: auto;
    font-size: 0.72rem;
    color: var(--dp-color-annotation);
  }
</style>
