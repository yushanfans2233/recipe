---
import { Image } from 'astro:assets';
import type { DemoRecipe } from '../../preview/demo';

interface Props {
  recipe: DemoRecipe;
}

const { recipe } = Astro.props;
const totalTime = recipe.steps
  .map((step) => step.time)
  .filter(Boolean)
  .join(' + ');
---

<article class="sheet">
  <header class="head">
    <div class="title-wrap">
      <h1 class="title">{recipe.title}</h1>
      <span class="ring" aria-hidden="true"></span>
    </div>
    <p class="byline">
      {recipe.category} · {recipe.steps.length} 个步骤 · 约 {totalTime}
    </p>
  </header>

  {
    recipe.photo && (
      <figure class="photo">
        <Image
          src={recipe.photo}
          alt={recipe.title}
          widths={[640, 1280]}
          sizes="(min-width: 900px) 880px, 100vw"
        />
      </figure>
    )
  }

  <section class="copy-block">
    <div class="fact">
      <h2 class="fact-title">食材</h2>
      <table class="mini">
        <tbody>
          {
            recipe.ingredients.map((row) => (
              <tr>
                <td>{row.name}</td>
                <td>{row.amount}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="fact">
      <h2 class="fact-title">调味</h2>
      {
        recipe.seasoning.map((group) => (
          <div class="group">
            {group.title && <p class="group-title">{group.title}</p>}
            <table class="mini">
              <tbody>
                {group.rows.map((row) => (
                  <tr>
                    <td>{row.name}</td>
                    <td>{row.amount}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))
      }
    </div>
  </section>

  <div class="steps">
    {
      recipe.steps.map((step, index) => (
        <section class="card">
          <h2 class="card-head">
            <span class="circle-no">{index + 1}</span>
            <span class="card-name">{step.label}</span>
            <span class="card-time">{step.time}</span>
          </h2>
          <ul class="card-items">
            {step.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <aside class="sticky">
    <h2 class="sticky-title">Tips</h2>
    <ol class="sticky-list">
      {recipe.tips.map((tip) => <li>{tip}</li>)}
    </ol>
  </aside>
</article>

<style>
  .sheet {
    max-width: 980px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
  }

  .head {
    margin-bottom: 2rem;
  }

  .title-wrap {
    position: relative;
    display: inline-block;
    padding: 0.1em 0.34em;
  }

  .title {
    font-family: var(--dp-typography-display-face);
    font-size: clamp(2.1rem, 5.5vw, 3.1rem);
    line-height: 1.15;
    color: var(--dp-color-ink);
  }

  .ring {
    position: absolute;
    inset: -14px -20px;
    border: 3.2px solid var(--pp-purple);
    border-radius: 47% 53% 52% 48% / 54% 46% 54% 46%;
    opacity: 0.82;
    transform: rotate(-1.4deg);
    pointer-events: none;
  }

  .ring::after {
    content: "";
    position: absolute;
    inset: 2px -4px -2px 4px;
    border: 1.3px solid var(--pp-purple);
    border-radius: inherit;
    opacity: 0.4;
  }

  
  .byline {
    margin-top: 0.9rem;
    font-size: 0.92rem;
    letter-spacing: 0.03em;
    color: var(--pp-blue);
  }

  .photo {
    margin: 0 0 2.4rem;
    padding: 10px;
    background-color: var(--dp-color-scrap);
    border: 1.5px solid color-mix(in srgb, var(--dp-color-line) 80%, transparent);
    box-shadow: 3px 3px 0 rgba(56, 53, 47, 0.1);
    transform: rotate(-0.4deg);
  }

  .photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .copy-block {
    display: grid;
    gap: 2rem;
    padding: 1.4rem 1.5rem 1.6rem;
    background-color: var(--dp-color-scrap);
    border: 1.5px solid color-mix(in srgb, var(--dp-color-line) 80%, transparent);
    box-shadow: 3px 3px 0 rgba(56, 53, 47, 0.08);
    transform: rotate(0.3deg);
  }

  @media (min-width: 680px) {
    .copy-block {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.6rem;
    }
  }

  .fact-title {
    margin-bottom: 0.55rem;
    padding-bottom: 0.3rem;
    border-bottom: 1.5px solid color-mix(in srgb, var(--pp-blue) 35%, transparent);
    font-family: var(--dp-typography-display-face);
    font-size: 1.28rem;
    letter-spacing: 0.05em;
    color: var(--pp-blue);
  }

  .mini {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.96rem;
  }

  .mini td {
    padding: 0.3rem 0;
    border-bottom: 1px dashed color-mix(in srgb, var(--dp-color-line) 65%, transparent);
    vertical-align: top;
  }

  .mini td:last-child {
    padding-left: 1rem;
    color: var(--dp-color-ink-muted);
    text-align: right;
    white-space: nowrap;
  }

  .group + .group {
    margin-top: 0.9rem;
  }

  .group-title {
    margin: 0.4rem 0 0.1rem;
    font-size: 0.84rem;
    letter-spacing: 0.1em;
    color: var(--pp-blue);
  }

  .steps {
    display: grid;
    gap: 1.6rem;
    margin-top: 2.8rem;
  }

  @media (min-width: 900px) {
    .steps {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .card {
    position: relative;
    padding: 1.3rem 1.3rem 1.4rem;
    background-color: var(--dp-color-scrap);
    border: 1.5px solid color-mix(in srgb, var(--dp-color-line) 80%, transparent);
    box-shadow: 3px 3px 0 rgba(56, 53, 47, 0.09);
    transform: rotate(-0.5deg);
  }

  .card:nth-child(even) {
    transform: rotate(0.55deg);
  }

  .card::before {
    content: "";
    position: absolute;
    top: -12px;
    left: 50%;
    width: 64px;
    height: 20px;
    margin-left: -32px;
    background-color: rgba(240, 223, 160, 0.62);
    border-top: 1px solid rgba(179, 172, 157, 0.4);
    border-bottom: 1px solid rgba(179, 172, 157, 0.4);
    clip-path: polygon(0 8%, 4% 0, 96% 3%, 100% 12%, 98% 92%, 94% 100%, 5% 97%, 1% 88%);
    transform: rotate(-2.4deg);
  }

  .card-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    font-weight: 400;
  }

  .card-name {
    font-family: var(--dp-typography-display-face);
    font-size: 1.26rem;
    color: var(--dp-color-ink);
  }

  .card-time {
    margin-left: auto;
    font-size: 0.8rem;
    letter-spacing: 0.03em;
    color: var(--pp-blue);
  }

  .circle-no {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.55rem;
    height: 1.55rem;
    border: 1.5px solid color-mix(in srgb, var(--pp-blue) 55%, transparent);
    border-radius: 55% 45% 50% 50% / 50% 55% 45% 50%;
    font-size: 0.78rem;
    line-height: 1;
    color: var(--pp-blue);
  }

  .card-items {
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
  }

  .card-items li {
    position: relative;
    margin-top: 0.45rem;
    padding-left: 1.4rem;
    font-size: 0.99rem;
    line-height: 1.86;
  }

  .card-items li::before {
    content: "–";
    position: absolute;
    left: 0;
    color: var(--pp-blue);
  }

  .sticky {
    position: relative;
    max-width: 560px;
    margin-top: 3.2rem;
    padding: 1.2rem 1.4rem 1.5rem;
    background-color: color-mix(in srgb, var(--dp-color-highlight) 58%, var(--dp-color-ground));
    box-shadow: 4px 4px 0 rgba(56, 53, 47, 0.08);
    transform: rotate(-1deg);
  }

  .sticky::before {
    content: "";
    position: absolute;
    top: -11px;
    right: 28px;
    width: 74px;
    height: 20px;
    background-color: rgba(247, 242, 231, 0.72);
    border-top: 1px solid rgba(179, 172, 157, 0.45);
    border-bottom: 1px solid rgba(179, 172, 157, 0.45);
    clip-path: polygon(0 10%, 5% 0, 97% 4%, 100% 14%, 98% 90%, 93% 100%, 4% 96%, 1% 86%);
    transform: rotate(2.6deg);
  }

  .sticky-title {
    font-family: var(--dp-typography-display-face);
    font-size: 1.24rem;
    color: var(--pp-blue);
  }

  .sticky-list {
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: tip;
  }

  .sticky-list li {
    position: relative;
    margin-top: 0.45rem;
    padding-left: 1.5rem;
    font-size: 0.92rem;
    line-height: 1.8;
    color: var(--dp-color-ink-muted);
    counter-increment: tip;
  }

  .sticky-list li::before {
    content: counter(tip) ".";
    position: absolute;
    left: 0;
    color: var(--pp-blue);
  }

  @media (max-width: 679px) {
    .sheet {
      padding: 1.5rem 1.25rem 4rem;
    }

    .card-time {
      margin-left: 0;
    }
  }
</style>
