---
import { Image } from 'astro:assets';
import type { DemoRecipe } from '../../preview/demo';

interface Props {
  recipe: DemoRecipe;
}

const { recipe } = Astro.props;
const totalTime = recipe.steps
  .map((step) => step.time)
  .filter(Boolean)
  .join(' + ');
---

<article class="sheet">
  <header class="head">
    <div class="title-wrap">
      <h1 class="title">{recipe.title}</h1>
      <span class="ring" aria-hidden="true"></span>
    </div>
    <p class="byline">
      {recipe.category} · {recipe.steps.length} 个步骤 · 约 {totalTime}
    </p>
  </header>

  {
    recipe.photo && (
      <figure class="photo">
        <Image
          src={recipe.photo}
          alt={recipe.title}
          widths={[640, 1280]}
          sizes="(min-width: 768px) 720px, 100vw"
        />
      </figure>
    )
  }

  <div class="facts">
    <section class="fact">
      <h2 class="fact-title">食材</h2>
      <table class="mini">
        <tbody>
          {
            recipe.ingredients.map((row) => (
              <tr>
                <td>{row.name}</td>
                <td>{row.amount}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="fact">
      <h2 class="fact-title">调味</h2>
      {
        recipe.seasoning.map((group) => (
          <div class="group">
            {group.title && <p class="group-title">{group.title}</p>}
            <table class="mini">
              <tbody>
                {group.rows.map((row) => (
                  <tr>
                    <td>{row.name}</td>
                    <td>{row.amount}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ))
      }
    </section>
  </div>

  <section class="process">
    <h2 class="section-title">制作流程</h2>
    {
      recipe.steps.map((step, index) => (
        <div class="step">
          <h3 class="step-head">
            <span class="circle-no">{index + 1}</span>
            <span class="step-label">Step {index + 1}</span>
            <span class="step-name">{step.label}</span>
            <span class="time-chip">{step.time}</span>
          </h3>
          <ol class="step-items">
            {step.items.map((item) => (
              <li>{item}</li>
            ))}
          </ol>
        </div>
      ))
    }
  </section>

  <section class="tips">
    <h2 class="section-title">Tips</h2>
    <ol class="tip-list">
      {recipe.tips.map((tip) => <li>{tip}</li>)}
    </ol>
  </section>
</article>

<style>
  .sheet {
    max-width: 760px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
  }

  .head {
    margin-bottom: 2rem;
  }

  .title-wrap {
    position: relative;
    display: inline-block;
    padding: 0.1em 0.34em;
  }

  .title {
    font-family: var(--dp-typography-display-face);
    font-size: clamp(2.1rem, 5.5vw, 3rem);
    line-height: 1.15;
    color: var(--dp-color-ink);
  }

  .ring {
    position: absolute;
    inset: -14px -20px;
    border: 3.2px solid var(--pp-purple);
    border-radius: 47% 53% 52% 48% / 54% 46% 54% 46%;
    opacity: 0.82;
    transform: rotate(-1.4deg);
    pointer-events: none;
  }

  .ring::after {
    content: "";
    position: absolute;
    inset: 2px -4px -2px 4px;
    border: 1.3px solid var(--pp-purple);
    border-radius: inherit;
    opacity: 0.4;
  }

  
  .byline {
    margin-top: 0.9rem;
    font-size: 0.92rem;
    letter-spacing: 0.03em;
    color: var(--pp-blue);
  }

  .photo {
    margin: 0 0 2.2rem;
    padding: 10px;
    background-color: var(--dp-color-scrap);
    border: 1.5px solid color-mix(in srgb, var(--dp-color-line) 80%, transparent);
    box-shadow: 3px 3px 0 rgba(56, 53, 47, 0.1);
    transform: rotate(-0.5deg);
  }

  .photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .facts {
    display: grid;
    gap: 2rem;
    padding-bottom: 0.5rem;
  }

  @media (min-width: 680px) {
    .facts {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.5rem;
    }
  }

  .fact-title {
    margin-bottom: 0.6rem;
    padding-bottom: 0.35rem;
    border-bottom: 1.5px solid color-mix(in srgb, var(--pp-blue) 35%, transparent);
    font-family: var(--dp-typography-display-face);
    font-size: 1.3rem;
    letter-spacing: 0.05em;
    color: var(--pp-blue);
  }

  .mini {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.98rem;
  }

  .mini td {
    padding: 0.32rem 0;
    border-bottom: 1px dashed color-mix(in srgb, var(--dp-color-line) 65%, transparent);
    vertical-align: top;
  }

  .mini td:last-child {
    padding-left: 1rem;
    color: var(--dp-color-ink-muted);
    text-align: right;
    white-space: nowrap;
  }

  .group + .group {
    margin-top: 0.9rem;
  }

  .group-title {
    margin: 0.4rem 0 0.1rem;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: var(--pp-blue);
  }

  .process,
  .tips {
    margin-top: 3rem;
  }

  .section-title {
    margin-bottom: 1.4rem;
    padding-bottom: 0.5rem;
    background-image: var(--dp-drawn-rule);
    background-repeat: repeat-x;
    background-position: left bottom;
    background-size: 40px 6px;
    font-family: var(--dp-typography-display-face);
    font-size: 1.6rem;
    color: var(--dp-color-ink);
  }

  .step + .step {
    margin-top: 2.2rem;
  }

  .step-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-items: center;
    font-weight: 400;
  }

  .step-label {
    font-family: var(--dp-typography-display-face);
    font-size: 1rem;
    letter-spacing: 0.08em;
    color: var(--pp-blue);
  }

  .step-name {
    font-family: var(--dp-typography-display-face);
    font-size: 1.3rem;
    color: var(--dp-color-ink);
  }

  .time-chip {
    margin-left: auto;
    padding: 0.05rem 0.6rem 0.12rem;
    border: 1.5px solid color-mix(in srgb, var(--pp-blue) 45%, transparent);
    border-radius: 52% 48% 46% 54% / 55% 45% 55% 45%;
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    color: var(--pp-blue);
  }

  .circle-no {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border: 1.5px solid color-mix(in srgb, var(--pp-blue) 55%, transparent);
    border-radius: 55% 45% 50% 50% / 50% 55% 45% 50%;
    font-size: 0.8rem;
    line-height: 1;
    color: var(--pp-blue);
  }

  .step-items {
    margin: 0.8rem 0 0;
    padding: 0;
    list-style: none;
    counter-reset: item;
  }

  .step-items li {
    position: relative;
    margin-top: 0.5rem;
    padding-left: 1.9rem;
    font-size: 1.02rem;
    line-height: 1.92;
    counter-increment: item;
  }

  .step-items li::before {
    content: counter(item) ".";
    position: absolute;
    left: 0.35rem;
    color: var(--pp-blue);
    font-size: 0.9rem;
  }

  .tip-list {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: tip;
  }

  .tip-list li {
    position: relative;
    margin-top: 0.55rem;
    padding-left: 1.6rem;
    font-size: 0.97rem;
    line-height: 1.85;
    color: var(--dp-color-ink-muted);
    counter-increment: tip;
  }

  .tip-list li::before {
    content: counter(tip) ".";
    position: absolute;
    left: 0;
    color: var(--pp-blue);
  }

  @media (max-width: 679px) {
    .sheet {
      padding: 1.5rem 1.25rem 4rem;
    }

    .time-chip {
      margin-left: 0;
    }
  }
</style>
