---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { RecipeParts } from '../../lib/recipe-html';

interface Props {
  title: string;
  category: string;
  tags: string[];
  cover?: ImageMetadata;
  parts: RecipeParts;
}

const { title, category, cover, parts } = Astro.props;
---

<article class="recipe-body page">
  <header class="head">
    <div>
      <p class="kicker">{category}</p>
      <h1 class="title">{title}</h1>
      <p class="meta">{parts.steps.length} 个步骤 · 食材 {parts.sideSections.length} 组</p>
    </div>
    {
      cover && (
        <figure class="thumb">
          <Image src={cover} alt={title} widths={[240]} class="thumb-img" />
        </figure>
      )
    }
  </header>

  <div class="layout">
    <aside class="rail">
      {parts.side.map((block) => <Fragment set:html={block} />)}
    </aside>

    <div class="steps">
      <p class="section-label">制作流程</p>
      {parts.steps.map((block) => <Fragment set:html={block} />)}
    </div>
  </div>

  {parts.tips && <section class="tips" set:html={parts.tips} />}
</article>

<style>
  .page {
    max-width: 1120px;
    margin: 0 auto;
    padding: 2.2rem 1.5rem 4rem;
  }

  .head {
    display: flex;
    gap: 2rem;
    align-items: flex-end;
    justify-content: space-between;
    padding-bottom: 1.4rem;
    border-bottom: 2px solid var(--dp-color-ink);
  }

  .kicker {
    font-size: 0.78rem;
    letter-spacing: 0.26em;
    color: var(--dp-color-annotation);
  }

  .title {
    margin-top: 0.25rem;
    font-family: var(--dp-typography-display-face);
    font-size: clamp(2rem, 4vw, 2.6rem);
    line-height: 1.15;
  }

  .meta {
    margin-top: 0.4rem;
    font-size: 0.88rem;
    letter-spacing: 0.04em;
    color: var(--dp-color-ink-muted);
  }

  .thumb {
    flex: none;
    width: 150px;
    padding: 6px;
    background-color: var(--dp-color-scrap);
    border: 1.5px solid color-mix(in srgb, var(--dp-color-line) 75%, transparent);
    transform: rotate(-0.8deg);
  }

  .thumb-img {
    display: block;
    width: 100%;
    height: 96px;
    object-fit: cover;
  }

  .layout {
    display: grid;
    grid-template-columns: 296px minmax(0, 1fr);
    gap: 3.5rem;
    align-items: start;
    margin-top: 2.2rem;
  }

  .rail {
    position: sticky;
    top: 1.4rem;
    padding-right: 2.4rem;
    border-right: 1px solid color-mix(in srgb, var(--dp-color-line) 55%, transparent);
  }

  .rail :global(h2) {
    margin: 0 0 0.5rem;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--dp-typography-reading-face);
    font-size: 0.76rem;
    font-weight: 400;
    letter-spacing: 0.24em;
    color: var(--dp-color-annotation);
  }

  .rail :global(h3) {
    margin: 1.15rem 0 0.2rem;
    font-family: var(--dp-typography-reading-face);
    font-size: 0.92rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--dp-color-ink);
  }

  .rail :global(p) {
    margin: 0.9rem 0 0.15rem;
    font-size: 0.76rem;
    letter-spacing: 0.18em;
    color: var(--dp-color-annotation);
  }

  .rail :global(table) {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    font-size: 1rem;
    line-height: 1.55;
  }

  .rail :global(thead) {
    display: none;
  }

  .rail :global(td) {
    padding: 0.34rem 0;
    border-bottom: 1px dotted color-mix(in srgb, var(--dp-color-line) 70%, transparent);
    background: none;
  }

  .rail :global(td:last-child) {
    padding-left: 1rem;
    color: var(--dp-color-ink-muted);
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .steps {
    min-width: 0;
    counter-reset: stepblock;
  }

  .section-label {
    margin-bottom: 1.2rem;
    font-size: 0.78rem;
    letter-spacing: 0.26em;
    color: var(--dp-color-annotation);
  }

  .steps :global(.step-block) {
    counter-increment: stepblock;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--dp-color-line) 45%, transparent);
  }

  .steps :global(.step-block:first-of-type) {
    padding-top: 0;
    border-top: 0;
  }

  .steps :global(.step-block h3) {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    margin: 0 0 0.7rem;
    padding: 0;
    background: none;
    font-size: 1.45rem;
    line-height: 1.3;
  }

  .steps :global(.step-name) {
    font-family: var(--dp-typography-display-face);
  }

  .steps :global(.step-block h3::before) {
    content: counter(stepblock);
    display: grid;
    flex: none;
    place-items: center;
    width: 1.7rem;
    height: 1.7rem;
    border: 1.5px solid color-mix(in srgb, var(--dp-color-accent) 45%, transparent);
    border-radius: 58% 42% 55% 45% / 45% 55% 48% 52%;
    font-family: var(--dp-typography-display-face);
    font-size: 0.8rem;
    color: var(--dp-color-accent);
  }

  .steps :global(.step-time) {
    margin-left: auto;
  }

  .steps :global(.step-time) {
    font-family: var(--dp-typography-reading-face);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    color: var(--dp-color-annotation);
  }

  .steps :global(.step-block > ol) {
    margin: 0;
    padding-left: 2.3rem;
    counter-reset: none;
  }

  .steps :global(.step-block > ol > li) {
    margin-top: 0.5rem;
    padding-left: 1.2rem;
    font-size: 1.14rem;
    line-height: 1.95;
  }

  .steps :global(.step-block > ol > li)::before {
    content: "·";
    top: 0.1em;
    width: auto;
    height: auto;
    border: 0;
    background: none;
    color: var(--dp-color-line);
  }

  .steps :global(.step-block strong) {
    background: none;
    font-weight: 700;
    font-synthesis: weight;
  }

  .tips {
    margin-top: 2.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid color-mix(in srgb, var(--dp-color-line) 45%, transparent);
  }

  .tips :global(h2) {
    margin: 0 0 1rem;
    border: 0;
    background: none;
    font-size: 0.78rem;
    letter-spacing: 0.26em;
    color: var(--dp-color-annotation);
  }

  .tips :global(ol > li) {
    font-size: 0.98rem;
    line-height: 1.9;
  }

  @media (max-width: 899px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .rail {
      position: static;
      padding-right: 0;
      border-right: 0;
      border-bottom: 1px solid color-mix(in srgb, var(--dp-color-line) 45%, transparent);
      padding-bottom: 1.4rem;
    }
  }
</style>
