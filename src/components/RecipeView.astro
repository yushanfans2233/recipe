---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { RecipeParts } from '../lib/recipe-html';

interface Props {
  title: string;
  category: string;
  tags: string[];
  cover?: ImageMetadata;
  parts: RecipeParts;
}

const { title, category, tags, cover, parts } = Astro.props;

const minutes = [...parts.steps.join('').matchAll(/step-time">(\d+)\s*(?:min|分钟)/g)]
  .map((match) => Number(match[1]))
  .reduce((sum, value) => sum + value, 0);
---

<article class="recipe-body page">
  <header class="masthead">
    {
      cover && (
        <figure class="thumb">
          <Image src={cover} alt={title} widths={[240]} class="thumb-img" />
        </figure>
      )
    }
    <div class="headline">
      <p class="kicker">{category}</p>
      <h1 class="title">{title}</h1>
      <p class="meta">
        {parts.steps.length} 步{minutes > 0 ? ` · 约 ${minutes} 分钟` : ''}{tags.length > 0 ? ` · ${tags.join(' / ')}` : ''}
      </p>
    </div>
  </header>

  <div class="layout">
    <aside class="rail" data-ingredients>
      <div class="rail-head">
        <span class="rail-label">食材</span>
        <button type="button" class="copy-btn" data-copy-ingredients aria-label="复制全部食材">
          <span data-copy-label>复制</span>
        </button>
      </div>
      {parts.side.map((block) => <Fragment set:html={block} />)}
    </aside>

    <div class="manual">
      {parts.steps.map((block) => <Fragment set:html={block} />)}
    </div>
  </div>

  {parts.tips && <section class="tips" set:html={parts.tips} />}

  <p class="copy-status" role="status" aria-live="polite" data-copy-status></p>
</article>

<style>
  .page {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.5rem 2.5rem;
  }

  .masthead {
    display: flex;
    gap: 1.4rem;
    align-items: center;
    padding-bottom: 1.1rem;
    border-bottom: 2px solid var(--dp-color-ink);
  }

  .thumb {
    flex: none;
    width: 104px;
    padding: 6px;
    background-color: var(--dp-color-scrap);
    border: 1.5px solid color-mix(in srgb, var(--dp-color-line) 80%, transparent);
    transform: rotate(-1deg);
  }

  .thumb-img {
    display: block;
    width: 100%;
    height: 82px;
    object-fit: cover;
  }

  .kicker {
    font-size: 0.72rem;
    letter-spacing: 0.26em;
    color: var(--dp-color-annotation);
  }

  .title {
    margin-top: 0.15rem;
    font-family: var(--dp-typography-display-face);
    font-size: clamp(1.8rem, 3.4vw, 2.3rem);
    line-height: 1.1;
  }

  .meta {
    margin-top: 0.3rem;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--dp-color-ink-muted);
  }

  .layout {
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
    margin-top: 1.6rem;
  }

  .rail {
    position: sticky;
    top: 1.2rem;
    padding-right: 2.2rem;
    border-right: 1px solid color-mix(in srgb, var(--dp-color-line) 45%, transparent);
  }

  .rail-head {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .rail-label {
    font-family: var(--dp-typography-reading-face);
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    color: var(--dp-color-annotation);
  }

  .copy-btn {
    padding: 0.05rem 0.6rem 0.12rem;
    border: 1.5px dashed color-mix(in srgb, var(--dp-color-line) 95%, transparent);
    border-radius: clamp(6px, 1vw, 10px);
    background: none;
    color: var(--dp-color-annotation);
    font-family: var(--dp-typography-reading-face);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition:
      color var(--dp-motion-control) ease,
      border-color var(--dp-motion-control) ease,
      background-color var(--dp-motion-control) ease;
  }

  .copy-btn:hover {
    border-color: var(--dp-color-annotation);
    color: var(--dp-color-ink);
  }

  .copy-btn.is-done {
    border-style: solid;
    border-color: color-mix(in srgb, var(--dp-color-accent) 55%, transparent);
    color: var(--dp-color-accent);
  }

  .rail :global(h2) {
    display: none;
  }

  .rail :global(h3) {
    margin: 0.9rem 0 0.1rem;
    font-family: var(--dp-typography-reading-face);
    font-size: 0.84rem;
    font-weight: 400;
    color: var(--dp-color-ink);
  }

  .rail :global(h4) {
    margin: 0.9rem 0 0.1rem;
    font-family: var(--dp-typography-reading-face);
    font-size: 0.84rem;
    font-weight: 400;
    color: var(--dp-color-ink);
  }

  .rail :global(p) {
    margin: 0.7rem 0 0.1rem;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--dp-color-annotation);
  }

  .rail :global(table) {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .rail :global(thead) {
    display: none;
  }

  .rail :global(td) {
    padding: 0.26rem 0;
    border-bottom: 1px dotted color-mix(in srgb, var(--dp-color-line) 60%, transparent);
    background: none;
  }

  .rail :global(td:last-child) {
    padding-left: 0.8rem;
    color: var(--dp-color-ink-muted);
    text-align: right;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .rail :global(ul) {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .rail :global(li) {
    padding: 0.2rem 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .rail :global(li::before) {
    content: none;
  }

  .rail :global(li input[type='checkbox']) {
    display: none;
  }

  .manual {
    counter-reset: stepblock;
  }

  .manual :global(.step-block) {
    counter-increment: stepblock;
    padding-bottom: 1.6rem;
  }

  .manual :global(.step-block + .step-block) {
    padding-top: 1.4rem;
    border-top: 1px solid color-mix(in srgb, var(--dp-color-line) 40%, transparent);
  }

  .manual :global(.step-block h3) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: baseline;
    margin: 0 0 0.7rem;
    padding: 0;
    background: none;
    font-size: 1.34rem;
    line-height: 1.3;
  }

  .manual :global(.step-block h3::before) {
    content: "STEP 0" counter(stepblock);
    flex: none;
    font-family: var(--dp-typography-reading-face);
    font-size: 0.68rem;
    letter-spacing: 0.18em;
    color: var(--dp-color-accent);
  }

  .manual :global(.step-name) {
    font-family: var(--dp-typography-display-face);
  }

  .manual :global(.step-time) {
    margin-left: auto;
    font-family: var(--dp-typography-reading-face);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--dp-color-annotation);
  }

  .manual :global(.step-block > ol) {
    margin: 0;
    padding-left: 0;
    counter-reset: mini;
  }

  .manual :global(.step-block > ol > li) {
    position: relative;
    margin-top: 0.55rem;
    padding-left: 2.2rem;
    font-size: 1rem;
    line-height: 1.85;
    counter-increment: mini;
  }

  .manual :global(.step-block > ol > li)::before {
    content: counter(mini);
    position: absolute;
    top: 0.28rem;
    left: 0;
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border: 1px solid color-mix(in srgb, var(--dp-color-line) 85%, transparent);
    border-radius: 50%;
    background: none;
    font-family: var(--dp-typography-reading-face);
    font-size: 0.68rem;
    color: var(--dp-color-ink-muted);
  }

  .manual :global(.step-block strong) {
    background: none;
    font-weight: 700;
    font-synthesis: weight;
  }

  .tips {
    margin-top: 1.6rem;
    padding-top: 1.2rem;
    border-top: 2px solid var(--dp-color-ink);
  }

  .tips :global(h2) {
    margin: 0 0 0.9rem;
    border: 0;
    background: none;
    font-family: var(--dp-typography-display-face);
    font-size: 0.95rem;
    letter-spacing: 0.2em;
    color: var(--dp-color-accent);
  }

  .tips :global(ol) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: tipbox;
  }

  .tips :global(li) {
    position: static;
    display: flex;
    gap: 0.7rem;
    margin: 0;
    padding: 0.85rem 1rem 0.9rem;
    border: 1.5px dashed color-mix(in srgb, var(--dp-color-annotation) 45%, transparent);
    border-radius: var(--dp-radius-control);
    font-size: 0.9rem;
    line-height: 1.75;
    counter-increment: tipbox;
  }

  .tips :global(li)::before {
    content: counter(tipbox);
    position: static;
    display: grid;
    flex: none;
    place-items: center;
    width: 1.4rem;
    height: 1.4rem;
    border: 1px solid color-mix(in srgb, var(--dp-color-annotation) 50%, transparent);
    border-radius: 50%;
    background: none;
    font-size: 0.66rem;
    color: var(--dp-color-annotation);
  }

  .copy-status {
    position: absolute;
    right: 1.5rem;
    bottom: 0.5rem;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    color: var(--dp-color-accent);
  }

  @media (max-width: 899px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }

    .rail {
      position: static;
      padding-right: 0;
      border-right: 0;
      border-bottom: 1px solid color-mix(in srgb, var(--dp-color-line) 45%, transparent);
      padding-bottom: 1.2rem;
    }
  }
</style>

<script>
  const rail = document.querySelector<HTMLElement>('[data-ingredients]');
  const button = document.querySelector<HTMLButtonElement>('[data-copy-ingredients]');
  const label = document.querySelector<HTMLElement>('[data-copy-label]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  function collectIngredients(): string {
    if (!rail) return '';
    const lines: string[] = [];

    rail.querySelectorAll('tr').forEach((row) => {
      const cells = row.querySelectorAll('td');
      if (cells.length !== 2) return;
      const name = cells[0].textContent?.trim() ?? '';
      const amount = cells[1].textContent?.trim() ?? '';
      if (name) lines.push(amount ? `${name} ${amount}` : name);
    });

    rail.querySelectorAll('li').forEach((item) => {
      const text = (item.textContent ?? '').replace(/\s+/g, ' ').trim();
      if (text) lines.push(text);
    });

    return lines.join('\n');
  }

  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const area = document.createElement('textarea');
      area.value = text;
      area.setAttribute('readonly', '');
      area.style.position = 'fixed';
      area.style.opacity = '0';
      document.body.append(area);
      area.select();
      const ok = document.execCommand('copy');
      area.remove();
      return ok;
    }
  }

  button?.addEventListener('click', async () => {
    const text = collectIngredients();
    if (!text) return;

    const ok = await copyText(text);
    if (!ok) {
      if (status) status.textContent = '复制失败，请手动选择文本';
      return;
    }

    button.classList.add('is-done');
    if (label) label.textContent = '已复制';
    if (status) status.textContent = `已复制 ${text.split('\n').length} 行食材`;

    window.setTimeout(() => {
      button.classList.remove('is-done');
      if (label) label.textContent = '复制';
      if (status) status.textContent = '';
    }, 1800);
  });
</script>
