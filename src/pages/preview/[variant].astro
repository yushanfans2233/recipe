---
import AddA from '../../components/preview/AddA.astro';
import AddB from '../../components/preview/AddB.astro';
import AddC from '../../components/preview/AddC.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../utils/url';

export function getStaticPaths() {
  return [
    { params: { variant: 'add-a' } },
    { params: { variant: 'add-b' } },
    { params: { variant: 'add-c' } },
  ];
}

const VARIANTS = {
  'add-a': { label: 'A · 单页长表单', desc: '从上往下一次填完，最简单直接' },
  'add-b': { label: 'B · 左填右预览', desc: '右边实时看到菜谱页长什么样' },
  'add-c': { label: 'C · 分步向导', desc: '一次一屏，填起来压力小，适合手机' },
} as const;

const { variant } = Astro.params;
const key = (variant ?? 'add-a') as keyof typeof VARIANTS;
const current = VARIANTS[key] ?? VARIANTS['add-a'];
const Component = key === 'add-b' ? AddB : key === 'add-c' ? AddC : AddA;
---

<BaseLayout title={`添加页 ${key.toUpperCase()}`} description="添加菜谱页版式样例" noindex note="版式样例">
  <div class="intro">
    <p class="intro-kicker">{current.label}</p>
    <p class="intro-desc">{current.desc}</p>
  </div>

  <Component />

  <nav class="switcher" aria-label="切换样例">
    <span class="switcher-label">版式</span>
    {
      Object.entries(VARIANTS).map(([variantKey, item]) => (
        <a
          href={url(`/preview/${variantKey}/`)}
          class:list={['switcher-link', { 'is-current': variantKey === key }]}
          aria-current={variantKey === key ? 'page' : undefined}
          title={item.label}
        >
          {variantKey.replace('add-', '').toUpperCase()}
        </a>
      ))
    }
  </nav>
</BaseLayout>

<style>
  .intro {
    max-width: 1180px;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 0;
  }

  .intro-kicker {
    font-family: var(--dp-typography-display-face);
    font-size: 1.05rem;
    letter-spacing: 0.04em;
    color: var(--dp-color-accent);
  }

  .intro-desc {
    margin-top: 0.25rem;
    font-size: 0.92rem;
    color: var(--dp-color-annotation);
  }

  .switcher {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 30;
    display: flex;
    gap: 0.3rem;
    align-items: center;
    padding: 0.25rem 0.45rem 0.25rem 0.8rem;
    background-color: var(--dp-color-scrap);
    border: 1.5px solid color-mix(in srgb, var(--dp-color-ink) 35%, transparent);
    border-radius: 999px;
    box-shadow: 3px 3px 0 rgba(56, 53, 47, 0.12);
  }

  .switcher-label {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--dp-color-ink-muted);
  }

  .switcher-link {
    display: grid;
    place-items: center;
    min-width: 1.8rem;
    height: 1.8rem;
    padding: 0 0.3rem;
    border: 1.5px solid transparent;
    border-radius: 50%;
    font-family: var(--dp-typography-display-face);
    font-size: 0.85rem;
    color: var(--dp-color-ink);
    text-decoration: none;
  }

  .switcher-link:hover {
    border-color: color-mix(in srgb, var(--dp-color-ink) 40%, transparent);
  }

  .switcher-link.is-current {
    background-color: var(--dp-color-ink);
    color: var(--dp-color-ground);
  }
</style>