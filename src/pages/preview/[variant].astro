---
import RecipeA from '../../components/preview/RecipeA.astro';
import RecipeB from '../../components/preview/RecipeB.astro';
import RecipeC from '../../components/preview/RecipeC.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { demoRecipe } from '../../preview/demo';
import { url } from '../../utils/url';

export function getStaticPaths() {
  return [{ params: { variant: 'a' } }, { params: { variant: 'b' } }, { params: { variant: 'c' } }];
}

const VARIANTS = {
  a: { label: 'A · 双栏手稿', desc: '左边步骤，右边食材/调味/时间/Tips —— 最接近你那张照片' },
  b: { label: 'B · 单栏横排', desc: '食材和调味并排在上，步骤通栏在下 —— 最好读' },
  c: { label: 'C · 步骤卡片', desc: '每一步一张贴纸卡片，食材是一张誊抄纸 —— 手账感' },
} as const;

const { variant } = Astro.params;
const key = (variant ?? 'a') as keyof typeof VARIANTS;
const current = VARIANTS[key] ?? VARIANTS.a;
const Component = key === 'b' ? RecipeB : key === 'c' ? RecipeC : RecipeA;
---

<BaseLayout
  title={`预览 ${key.toUpperCase()} · ${current.label}`}
  description="菜谱详情页版式预览"
  noindex
  bodyClass="paper-grid"
>
  <div class="intro">
    <p class="intro-kicker">版式预览 · {current.label}</p>
    <p class="intro-desc">{current.desc}</p>
    <p class="intro-sample">样例菜品：{demoRecipe.title}（其他菜谱会套用同一版式）</p>
  </div>

  <Component recipe={demoRecipe} />

  <nav class="switcher" aria-label="切换版式">
    <span class="switcher-label">版式</span>
    {
      Object.entries(VARIANTS).map(([variantKey, item]) => (
        <a
          href={url(`/preview/${variantKey}/`)}
          class:list={['switcher-link', { 'is-current': variantKey === key }]}
          aria-current={variantKey === key ? 'page' : undefined}
          title={item.label}
        >
          {variantKey.toUpperCase()}
        </a>
      ))
    }
  </nav>
</BaseLayout>

<style>
  .intro {
    max-width: 1180px;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 0;
  }

  .intro-kicker {
    font-family: var(--dp-typography-display-face);
    font-size: 1.1rem;
    letter-spacing: 0.04em;
    color: var(--pp-purple);
  }

  .intro-desc {
    margin-top: 0.4rem;
    font-size: 0.95rem;
    color: var(--pp-blue);
  }

  .intro-sample {
    margin-top: 0.2rem;
    font-size: 0.84rem;
    color: var(--dp-color-ink-muted);
  }

  .switcher {
    position: fixed;
    right: 0.9rem;
    bottom: 0.9rem;
    z-index: 30;
    display: flex;
    gap: 0.3rem;
    align-items: center;
    padding: 0.25rem 0.4rem 0.25rem 0.75rem;
    background-color: var(--dp-color-scrap);
    border: 1.5px solid color-mix(in srgb, var(--pp-blue) 40%, transparent);
    border-radius: 999px;
    box-shadow: 3px 3px 0 rgba(56, 53, 47, 0.12);
    opacity: 0.95;
  }

  .switcher-label {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: var(--pp-blue);
  }

  .switcher-link {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1.5px solid transparent;
    border-radius: 50%;
    font-family: var(--dp-typography-display-face);
    font-size: 0.9rem;
    color: var(--pp-blue);
    text-decoration: none;
  }

  .switcher-link:hover {
    border-color: color-mix(in srgb, var(--pp-blue) 45%, transparent);
  }

  .switcher-link.is-current {
    background-color: var(--pp-blue);
    color: var(--dp-color-ground);
  }
</style>
