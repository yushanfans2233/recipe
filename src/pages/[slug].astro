---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import PencilArrow from '../components/PencilArrow.astro';
import RecipeView from '../components/RecipeView.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { splitRecipeContent } from '../lib/recipe-html';
import { parseRecipeMarkdown } from '../lib/recipe-parse';
import { getRecipes, coverFor, recipeUrl, type Recipe } from '../lib/recipes';
import { url } from '../utils/url';

export async function getStaticPaths() {
  const recipes = await getRecipes();

  return recipes.map((recipe, index) => ({
    params: { slug: recipe.id },
    props: {
      recipe,
      prev: recipes[index - 1] ?? null,
      next: recipes[index + 1] ?? null,
    },
  }));
}

interface Props {
  recipe: Recipe;
  prev: Recipe | null;
  next: Recipe | null;
}

const { recipe, prev, next } = Astro.props;
const { Content } = await render(recipe);
const parts = await splitRecipeContent(Content);
const { title, category, tags } = recipe.data;
const cover = coverFor(recipe.data.cover);
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const coverUrl = cover ? new URL(cover.src, siteUrl).href : undefined;

const description = `${title}（${category}）的食材清单与制作步骤。`;

const parsed = parseRecipeMarkdown(recipe.body ?? '');
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: title,
  description,
  image: coverUrl ? [coverUrl] : undefined,
  recipeCategory: category,
  keywords: tags.join(', ') || undefined,
  totalTime: recipe.data.time ? `PT${recipe.data.time}M` : undefined,
  recipeIngredient: [...parsed.ingredients, ...parsed.seasoning],
  recipeInstructions: parsed.steps.map((step) => ({
    '@type': 'HowToStep',
    name: step.name,
    text: step.items.join('；'),
  })),
};
---

<BaseLayout title={title} description={description} image={coverUrl} note={category}>
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
  <div class="mx-auto w-full max-w-[1080px] px-6 pt-8">
    <a
      href={url('/')}
      class="note inline-flex items-center gap-2 underline decoration-dotted underline-offset-4 hover:decoration-solid"
    >
      <PencilArrow />
      全部菜谱
    </a>
  </div>

  {
    parts.ok ? (
      <div class="mt-5">
        <RecipeView title={title} category={category} tags={tags} cover={cover} parts={parts} />
      </div>
    ) : (
      <div class="mx-auto mt-6 w-full max-w-3xl px-6">
        {cover && (
          <div class="hero-ref">
            <Image
              src={cover}
              alt={title}
              widths={[800, 1600]}
              sizes="(min-width: 1024px) 768px, 100vw"
              class="block h-auto max-h-[70vh] w-full object-cover"
            />
          </div>
        )}
        <div class="recipe-body mt-10">
          <Content />
        </div>
      </div>
    )
  }

  <nav class="mx-auto mt-16 w-full max-w-[1080px] px-6" aria-label="前后菜谱">
    <div class="rule-dashed flex items-start justify-between gap-6 pt-6">
      {
        prev ? (
          <a href={recipeUrl(prev.id)} class="group block max-w-[46%]">
            <span class="note flex items-center gap-2">
              <PencilArrow />
              上一道
            </span>
            <span class="dish-name mt-1 block group-hover:underline group-hover:decoration-dotted group-hover:underline-offset-4">
              {prev.data.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={recipeUrl(next.id)} class="group block max-w-[46%] text-right">
            <span class="note flex items-center justify-end gap-2">
              下一道
              <PencilArrow direction="right" />
            </span>
            <span class="dish-name mt-1 block group-hover:underline group-hover:decoration-dotted group-hover:underline-offset-4">
              {next.data.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
    </div>
  </nav>
</BaseLayout>