---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import PencilArrow from '../components/PencilArrow.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { splitRecipeContent } from '../lib/recipe-html';
import { getRecipes, coverFor, recipeUrl, type Recipe } from '../lib/recipes';
import { url } from '../utils/url';

export async function getStaticPaths() {
  const recipes = await getRecipes();

  return recipes.map((recipe, index) => ({
    params: { slug: recipe.id },
    props: {
      recipe,
      prev: recipes[index - 1] ?? null,
      next: recipes[index + 1] ?? null,
    },
  }));
}

interface Props {
  recipe: Recipe;
  prev: Recipe | null;
  next: Recipe | null;
}

const { recipe, prev, next } = Astro.props;
const { Content } = await render(recipe);
const parts = await splitRecipeContent(Content);
const { title, category, tags } = recipe.data;
const cover = coverFor(recipe.data.cover);
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const coverUrl = cover ? new URL(cover.src, siteUrl).href : undefined;

const description = `${title}（${category}）的食材清单与制作步骤。`;
---

<BaseLayout title={title} description={description} image={coverUrl} note={category}>
  <article class="mx-auto w-full max-w-6xl px-6 pt-10 pb-4 sm:pt-14">
    <a
      href={url('/')}
      class="note inline-flex items-center gap-2 underline decoration-dotted underline-offset-4 hover:decoration-solid"
    >
      <PencilArrow />
      全部菜谱
    </a>

    <header class="mt-8">
      <p class="annotation">{category}</p>
      <h1 class="statement mt-2 text-[clamp(2.4rem,6.5vw,3.8rem)] leading-[1.08]">{title}</h1>
      {
        tags.length > 0 && (
          <p class="tag-note mt-3 flex flex-wrap gap-x-3 gap-y-1">
            {tags.map((tag) => (
              <span>#{tag}</span>
            ))}
          </p>
        )
      }
    </header>

    {
      parts.ok ? (
        <div class="recipe-body detail-spread mt-12">
          <div class="detail-main">
            {cover && (
              <figure class="detail-photo">
                <Image
                  src={cover}
                  alt={title}
                  widths={[480, 960]}
                  sizes="(min-width: 1050px) 620px, 100vw"
                  class="block h-auto w-full object-cover"
                />
              </figure>
            )}
            <h2 class="detail-process-title">{parts.processTitle}</h2>
            <div class="steps-flow">
              {parts.steps.map((block) => (
                <Fragment set:html={block} />
              ))}
            </div>
          </div>

          <aside class="detail-side">
            {parts.side.map((block) => (
              <Fragment set:html={block} />
            ))}
            {parts.schedule && <div class="detail-schedule" set:html={parts.schedule} />}
          </aside>

          {parts.tips && <section class="detail-tips" set:html={parts.tips} />}
        </div>
      ) : (
        <>
          {cover && (
            <div class="hero-ref mt-10">
              <Image
                src={cover}
                alt={title}
                widths={[800, 1600]}
                sizes="(min-width: 1024px) 960px, 100vw"
                class="block h-auto max-h-[70vh] w-full object-cover"
              />
            </div>
          )}
          <div class="recipe-body mx-auto mt-14 max-w-3xl">
            <Content />
          </div>
        </>
      )
    }

    <nav class="mx-auto mt-20 max-w-3xl" aria-label="前后菜谱">
      <div class="rule-dashed flex items-start justify-between gap-6 pt-6">
        {
          prev ? (
            <a href={recipeUrl(prev.id)} class="group block max-w-[46%]">
              <span class="note flex items-center gap-2">
                <PencilArrow />
                上一道
              </span>
              <span class="dish-name mt-1 block group-hover:underline group-hover:decoration-dotted group-hover:underline-offset-4">
                {prev.data.title}
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a href={recipeUrl(next.id)} class="group block max-w-[46%] text-right">
              <span class="note flex items-center justify-end gap-2">
                下一道
                <PencilArrow direction="right" />
              </span>
              <span class="dish-name mt-1 block group-hover:underline group-hover:decoration-dotted group-hover:underline-offset-4">
                {next.data.title}
              </span>
            </a>
          ) : (
            <span />
          )
        }
      </div>
    </nav>
  </article>
</BaseLayout>