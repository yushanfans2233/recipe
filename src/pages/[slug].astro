---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRecipes, coverFor, recipeUrl, type Recipe } from '../lib/recipes';
import { url } from '../utils/url';

export async function getStaticPaths() {
  const recipes = await getRecipes();

  return recipes.map((recipe, index) => ({
    params: { slug: recipe.id },
    props: {
      recipe,
      prev: recipes[index - 1] ?? null,
      next: recipes[index + 1] ?? null,
    },
  }));
}

interface Props {
  recipe: Recipe;
  prev: Recipe | null;
  next: Recipe | null;
}

const { recipe, prev, next } = Astro.props;
const { Content } = await render(recipe);
const { title, category, tags } = recipe.data;
const cover = coverFor(recipe.data.cover);
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const coverUrl = cover ? new URL(cover.src, siteUrl).href : undefined;

const description = `${title}（${category}）的食材清单与制作步骤。`;
---

<BaseLayout title={title} description={description} image={coverUrl}>
  <article class="mx-auto w-full max-w-5xl px-6 pt-10 pb-4">
    <a href={url('/')} class="text-xs tracking-[0.15em] text-neutral-400 transition-colors hover:text-black">
      ← 全部菜谱
    </a>

    <header class="mt-10 border-b border-neutral-900 pb-8">
      <p class="text-[11px] tracking-[0.25em] text-neutral-400 uppercase">{category}</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
      {
        tags.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-xs text-neutral-400">
            {tags.map((tag) => (
              <li>#{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    {
      cover && (
        <div class="mt-10 overflow-hidden bg-neutral-100">
          <Image
            src={cover}
            alt={title}
            widths={[800, 1600]}
            sizes="(min-width: 1024px) 960px, 100vw"
            class="photo h-auto max-h-[70vh] w-full object-cover"
          />
        </div>
      )
    }

    <div class="recipe-body mx-auto mt-14 max-w-3xl">
      <Content />
    </div>

    <nav
      class="mx-auto mt-20 flex max-w-3xl items-start justify-between gap-8 border-t border-neutral-200 pt-6 text-sm"
      aria-label="前后菜谱"
    >
      {
        prev ? (
          <a href={recipeUrl(prev.id)} class="group max-w-[45%]">
            <span class="block text-[11px] tracking-[0.15em] text-neutral-400">上一道</span>
            <span class="mt-1.5 block font-medium group-hover:underline">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a href={recipeUrl(next.id)} class="group max-w-[45%] text-right">
            <span class="block text-[11px] tracking-[0.15em] text-neutral-400">下一道</span>
            <span class="mt-1.5 block font-medium group-hover:underline">{next.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</BaseLayout>
