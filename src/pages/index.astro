---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { CATEGORY_ORDER, coverFor, getRecipes, recipeUrl } from '../lib/recipes';
import { parseRecipeMarkdown } from '../lib/recipe-parse';

const recipes = await getRecipes();
const categories = CATEGORY_ORDER.filter((category) =>
  recipes.some((recipe) => recipe.data.category === category),
);

const countOf = (category: string) =>
  recipes.filter((recipe) => recipe.data.category === category).length;

/** 每道菜的搜索文本：菜名 + 分类 + 标签 + 食材 + 调味 */
const searchText = (body: string, title: string, category: string, tags: string[]) => {
  const parsed = parseRecipeMarkdown(body);
  return [title, category, ...tags, ...parsed.ingredients, ...parsed.seasoning]
    .join(' ')
    .replace(/\s+/g, ' ')
    .toLowerCase();
};
---

<BaseLayout
  title="菜谱"
  description={`${recipes.length} 道家常菜谱，点击查看食材清单与制作步骤。`}
  note="家常菜谱"
>
  <section class="mx-auto w-full max-w-6xl px-6 pt-12 sm:pt-16">
    <div class="grid gap-8 min-[1050px]:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] min-[1050px]:items-end">
      <h1 class="statement text-[clamp(3.4rem,9vw,5.6rem)] leading-[1.02]">
        <span class="underline-drawn">菜谱</span>
      </h1>

      <div class="min-[1050px]:pb-4">
        <p class="note text-[1.06rem] leading-relaxed">
          共 {recipes.length} 道菜。点击图片查看食材清单与做法。
        </p>
        <p class="annotation mt-2">
          蛋白质 {countOf('蛋白质')} · 蔬菜 {countOf('蔬菜')} · 主食 {countOf('主食')}
        </p>
      </div>
    </div>

    <svg
      class="doodle mt-7 h-16 w-28"
      viewBox="0 0 112 64"
      fill="none"
      aria-hidden="true"
      focusable="false"
    >
      <path
        d="M8 6c18 3 32 14 36 30 2 8 1 14-2 20"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"></path>
      <path
        d="M33 49l9 8 8-10"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </section>

  <div class="mx-auto w-full max-w-6xl px-6">
    <div class="search-row">
      <label class="search-field">
        <span class="sr-only">搜索菜谱</span>
        <input
          type="search"
          class="search-input"
          placeholder="搜菜名、食材或标签，比如「豆腐」"
          data-search-input
          autocomplete="off"
        />
      </label>
      <p class="search-count" data-search-count aria-live="polite">{recipes.length} 道菜</p>
    </div>
  </div>

  <nav class="mx-auto mt-5 w-full max-w-6xl px-6" aria-label="按分类筛选">
    <div class="flex flex-wrap items-center gap-3">
      <button type="button" class="sketch-btn" data-filter="all" aria-pressed="true">
        全部 <span class="btn-count">{recipes.length}</span>
      </button>
      {
        categories.map((category) => (
          <button type="button" class="sketch-btn" data-filter={category} aria-pressed="false">
            {category} <span class="btn-count">{countOf(category)}</span>
          </button>
        ))
      }
    </div>
  </nav>

  <ul
    class="photo-grid mx-auto mt-12 grid w-full max-w-6xl grid-cols-1 gap-x-8 gap-y-14 px-6 pb-12 min-[680px]:grid-cols-2 min-[1050px]:grid-cols-3"
  >
    {
      recipes.map((recipe) => {
        const cover = coverFor(recipe.data.cover);
        return (
          <li
            data-category={recipe.data.category}
            data-search={searchText(
              recipe.body ?? '',
              recipe.data.title,
              recipe.data.category,
              recipe.data.tags,
            )}
          >
            <a href={recipeUrl(recipe.id)} class="ref-card">
              {cover ? (
                <Image
                  src={cover}
                  alt=""
                  widths={[400, 800, 1200]}
                  sizes="(min-width: 1050px) 33vw, (min-width: 680px) 50vw, 100vw"
                  class="ref-photo"
                  loading="lazy"
                />
              ) : (
                <span class="ref-placeholder" aria-hidden="true">
                  {recipe.data.title}
                </span>
              )}
              <span class="flex items-baseline justify-between gap-3 px-1 pt-3 pb-4">
                <span class="dish-name">{recipe.data.title}</span>
                <span class="card-meta shrink-0">{recipe.data.category}</span>
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>

  <p class="mx-auto w-full max-w-6xl px-6 pb-16 text-center text-sm text-muted" data-empty hidden>
    没有找到匹配的菜，换个词试试。
  </p>
</BaseLayout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.photo-grid > li'));
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const count = document.querySelector<HTMLElement>('[data-search-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  let activeCategory = 'all';

  function apply() {
    const query = (input?.value ?? '').trim().toLowerCase();
    let visible = 0;

    for (const card of cards) {
      const inCategory = activeCategory === 'all' || card.dataset.category === activeCategory;
      const hit = !query || (card.dataset.search ?? '').includes(query);
      const show = inCategory && hit;
      card.hidden = !show;
      if (show) visible += 1;
    }

    for (const button of buttons) {
      button.setAttribute('aria-pressed', String((button.dataset.filter ?? 'all') === activeCategory));
    }

    if (count) count.textContent = `${visible} 道菜`;
    if (empty) empty.hidden = visible !== 0;
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      activeCategory = button.dataset.filter ?? 'all';
      apply();
    });
  }

  input?.addEventListener('input', apply);
</script>

<style>
  .search-row {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 2.2rem;
    padding-bottom: 0.6rem;
    border-bottom: 1.5px dashed color-mix(in srgb, var(--dp-color-line) 80%, transparent);
  }

  .search-field {
    flex: 1;
    min-width: 0;
  }

  .search-input {
    width: 100%;
    padding: 0.3rem 0.1rem 0.45rem;
    border: 0;
    background: transparent;
    color: var(--dp-color-ink);
    font-family: var(--dp-typography-reading-face);
    font-size: 1.1rem;
  }

  .search-input::placeholder {
    color: color-mix(in srgb, var(--dp-color-ink) 32%, transparent);
  }

  .search-input:focus {
    outline: none;
    background-color: color-mix(in srgb, var(--dp-color-highlight) 26%, transparent);
  }

  .search-count {
    flex: none;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--dp-color-annotation);
  }
</style>
